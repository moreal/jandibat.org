APP_ENV=production
BUILD_SHA=replace-with-40-character-git-sha
REGION=replace-with-staging-region
API_ADDR=:8080
PUBLIC_BASE_URL=https://api.staging.jandibat.org
WEB_BASE_URL=https://staging.jandibat.org
DATABASE_URL=postgresql://jandibat_api:replace-me@cockroach.example:26257/jandibat?sslmode=verify-full
WORKER_DATABASE_URL=postgresql://jandibat_worker:replace-me@cockroach.example:26257/jandibat?sslmode=verify-full
MAINTENANCE_DATABASE_URL=postgresql://jandibat_maintenance:replace-me@cockroach.example:26257/jandibat?sslmode=verify-full
WORKER_HEALTH_ADDR=:8081
MAINTENANCE_HEALTH_ADDR=:8082
DEVELOPMENT_ALL_IN_ONE=false
MIGRATION_DATABASE_URL=postgresql://jandibat_migrator:replace-me@cockroach.example:26257/jandibat?sslmode=verify-full
BACKUP_DATABASE_URL=postgresql://jandibat_backup:replace-me@cockroach.example:26257/jandibat?sslmode=verify-full
RESTORE_DATABASE_URL=postgresql://jandibat_restore:replace-with-short-lived-drill-credential@cockroach.example:26257/defaultdb?sslmode=verify-full
# The URL template must bind the read-only maintenance role to the literal
# {database} placeholder. The isolated API must be started against that same
# restored database before this full gate runs.
RESTORE_MAINTENANCE_DATABASE_URL_TEMPLATE=postgresql://jandibat_maintenance:replace-me@cockroach.example:26257/{database}?sslmode=verify-full
RESTORE_API_DATABASE_URL_TEMPLATE=postgresql://jandibat_api:replace-me@cockroach.example:26257/{database}?sslmode=verify-full
RESTORE_FIXTURE_SUBJECT=restore-fixture
RESTORE_MAX_RPO_SECONDS=3600
RESTORE_MAX_RTO_SECONDS=14400
SESSION_SIGNING_KEY=replace-with-unpadded-base64
DELETION_PSEUDONYM_KEY=replace-with-unpadded-base64url-for-at-least-32-bytes
DELETED_IDENTITY_HMAC_ACTIVE_KEY_ID=identity-2026-08-a
DELETED_IDENTITY_HMAC_KEYS={"identity-2026-08-a":"replace-with-distinct-unpadded-standard-base64-for-exactly-32-bytes"}
CREDENTIAL_ACTIVE_KEY_ID=staging-2026-08
CREDENTIAL_ENCRYPTION_PUBLIC_KEYS={"staging-2026-08":"replace-with-unpadded-base64-pkix-der"}
CREDENTIAL_ENCRYPTION_PRIVATE_KEYS={"staging-2026-08":"replace-with-unpadded-base64-pkcs8-der"}
# Optional legacy v1/v2 migration material; never inject either value into API.
CREDENTIAL_ENCRYPTION_KEYS={}
CREDENTIAL_ENCRYPTION_KEY=
SMTP_ADDR=smtp.example:465
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=noreply@staging.jandibat.org
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITLAB_CLIENT_ID=replace-me
GITLAB_CLIENT_SECRET=replace-me
CODEBERG_CLIENT_ID=replace-me
CODEBERG_CLIENT_SECRET=replace-me
SCHEDULER_INTERVAL=15m
SHUTDOWN_TIMEOUT=40s
RETENTION_INTERVAL=24h
REENCRYPTION_INTERVAL=1h
MAINTENANCE_TIMEOUT=15m
MAINTENANCE_BATCH_SIZE=500
RETENTION_MAX_BATCHES=30
TRUST_PROXY_HEADERS=true
JANDIBAT_API_BASE_URL=https://api.staging.jandibat.org
BACKUP_EXTERNAL_CONNECTION=jandibat_staging_backup
BACKUP_SCHEDULE_LABEL=jandibat_hourly_backup
