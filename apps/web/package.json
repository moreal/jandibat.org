{
  "name": "@jandibat/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview",
    "test": "node --experimental-strip-types --test test/*.test.mjs && vitest run && sh test/runtime-config.test.sh",
    "typecheck": "tsc --noEmit",
    "openapi:types": "openapi-typescript ../../openapi/jandibat.yaml -o src/generated/api.ts"
  },
  "dependencies": {
    "@jandibat/contracts": "workspace:*",
    "@solidjs/router": "2.0.0-next.16",
    "@solidjs/web": "2.0.0-rc.0",
    "solid-js": "2.0.0-rc.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@solidjs/vite-plugin": "3.0.0-next.28",
    "filesystem-routing": "0.2.1",
    "happy-dom": "20.11.2",
    "linkedom": "^0.18.12",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.7.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
