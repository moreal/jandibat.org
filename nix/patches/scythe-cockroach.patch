+fn normalize_cockroach_upsert_for_parser(sql: &str) -> String {
+    let mask = mask_postgres_for_scan(sql);
+    let Some(start) = mask.bytes().position(|byte| !byte.is_ascii_whitespace()) else {
+        return sql.to_string();
+    };
+    let end = start + "UPSERT".len();
+    if !mask[start..].starts_with("UPSERT")
+        || !mask.as_bytes().get(end).is_some_and(|byte| byte.is_ascii_whitespace())
+    {
+        return sql.to_string();
+    }
+    let mut rewritten = sql.to_string();
+    rewritten.replace_range(start..end, "INSERT");
+    rewritten
