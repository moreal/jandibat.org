"A durable entity with an opaque, globally unique identity."
interface Node {
  id: ID!
}

type Subject implements Node {
  id: ID!
  handle: String!
  displayName: String
  timezone: TimeZone!
  isPublic: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
  "Owner-only settings; null for anonymous or non-owner readers."
  settings: SubjectSettings
  "A bounded, static projection; non-owners see only public activity."
  activitySnapshot(
    range: DateRangeInput!
    timezone: TimeZone!
    environmentIDs: [String!]
  ): ActivitySnapshot!
}

type ProviderConnection implements Node {
  id: ID!
  "Forward page; first: 1..100, default 25."
  syncJobs(first: Int = 25, after: Cursor): SyncJobConnection
}

type CustomProvider implements Node {
  id: ID!
}

type SyncJob implements Node {
  id: ID!
  status: String!
  attempt: Int!
  createdAt: DateTime!
  updatedAt: DateTime!
}

type Session implements Node {
  id: ID!
  createdAt: DateTime!
  expiresAt: DateTime!
  revokedAt: DateTime
  lastSeenAt: DateTime
  ipAddress: String
  userAgent: String
}
