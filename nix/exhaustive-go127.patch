diff --git a/fact.go b/fact.go
index a62af70..1c03b8e 100644
--- a/fact.go
+++ b/fact.go
@@ -3 +3,7 @@
-import "golang.org/x/tools/go/analysis"
+import (
+	"bytes"
+	"encoding/gob"
+	"go/token"
+
+	"golang.org/x/tools/go/analysis"
+)
@@ -13,0 +20,33 @@ func (f *enumMembersFact) String() string { return f.Members.factString() }
+
+type enumMemberFactEntry struct {
+	Name  string
+	Pos   token.Pos
+	Value constantValue
+}
+
+func (f *enumMembersFact) GobEncode() ([]byte, error) {
+	entries := make([]enumMemberFactEntry, 0, len(f.Members.Names))
+	for _, name := range f.Members.Names {
+		entries = append(entries, enumMemberFactEntry{
+			Name:  name,
+			Pos:   f.Members.NameToPos[name],
+			Value: f.Members.NameToValue[name],
+		})
+	}
+
+	var buf bytes.Buffer
+	err := gob.NewEncoder(&buf).Encode(entries)
+	return buf.Bytes(), err
+}
+
+func (f *enumMembersFact) GobDecode(data []byte) error {
+	var entries []enumMemberFactEntry
+	if err := gob.NewDecoder(bytes.NewReader(data)).Decode(&entries); err != nil {
+		return err
+	}
+	f.Members = enumMembers{}
+	for _, entry := range entries {
+		f.Members.add(entry.Name, entry.Value, entry.Pos)
+	}
+	return nil
+}
