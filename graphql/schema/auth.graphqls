"The viewer is a scoped value object, not a globally addressable Node."
type Viewer {
  user: UserProfile!
  "Forward page; first: 1..100, default 25."
  sessions(first: Int = 25, after: Cursor): SessionConnection!
}

type UserProfile {
  id: String!
  primaryEmail: String!
  status: String!
  emailVerifiedAt: DateTime
  createdAt: DateTime!
  updatedAt: DateTime!
}

"Standard forward-only Relay connection page information."
type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: Cursor
  endCursor: Cursor
}

type SessionEdge {
  cursor: Cursor!
  node: Session!
}

type SessionConnection {
  edges: [SessionEdge!]!
  pageInfo: PageInfo!
}
