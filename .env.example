# Runtime
APP_ENV=development
BUILD_SHA=development
REGION=local
API_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://root@localhost:26257/jandibat?sslmode=disable
WORKER_DATABASE_URL=postgresql://root@localhost:26257/jandibat?sslmode=disable
MAINTENANCE_DATABASE_URL=postgresql://root@localhost:26257/jandibat?sslmode=disable
WORKER_HEALTH_ADDR=:8081
MAINTENANCE_HEALTH_ADDR=:8082
# Development-only compatibility mode. Production rejects true.
DEVELOPMENT_ALL_IN_ONE=false

# Secret material is unpadded standard base64 and may be empty in development.
# Production uses RSA public/private DER maps: the API receives only the public
# map, while worker/maintenance receive both maps. New records receive a random
# per-record DEK wrapped by the active RSA public key. The symmetric map and
# single key are optional legacy decrypt-only inputs for worker/maintenance.
SESSION_SIGNING_KEY=
# Independent unpadded base64url key (at least 32 decoded bytes) for deletion
# audit pseudonyms. Never reuse SESSION_SIGNING_KEY.
DELETION_PSEUDONYM_KEY=
DELETED_IDENTITY_HMAC_ACTIVE_KEY_ID=
DELETED_IDENTITY_HMAC_KEYS={}
CREDENTIAL_ACTIVE_KEY_ID=
CREDENTIAL_ENCRYPTION_PUBLIC_KEYS={}
CREDENTIAL_ENCRYPTION_PRIVATE_KEYS={}
CREDENTIAL_ENCRYPTION_KEYS={}
CREDENTIAL_ENCRYPTION_KEY=

# SMTP is worker-only in production. The API enqueues a token-free delivery
# intent; only the worker creates the one-time token and sends mail.
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth applications
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=

# Durations use Go duration syntax, for example 30s, 15m, or 1h.
SCHEDULER_INTERVAL=15m
SHUTDOWN_TIMEOUT=40s
RETENTION_INTERVAL=24h
REENCRYPTION_INTERVAL=1h
MAINTENANCE_TIMEOUT=15m
MAINTENANCE_BATCH_SIZE=500
RETENTION_MAX_BATCHES=30

# Only enable behind a trusted proxy that sanitizes forwarding headers.
TRUST_PROXY_HEADERS=false
